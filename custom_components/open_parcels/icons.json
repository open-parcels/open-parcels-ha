{
  "entity": {
    "binary_sensor": {
      "event_stream": { "default": "mdi:lan-connect", "state": { "off": "mdi:lan-disconnect" } },
      "connection_problem": { "default": "mdi:account-check", "state": { "on": "mdi:account-alert" } },
      "server_health": { "default": "mdi:heart-pulse", "state": { "on": "mdi:alert-circle-outline" } }
    },
    "button": {
      "refresh": { "default": "mdi:refresh" },
      "back_up": { "default": "mdi:database-export" }
    },
    "calendar": {
      "deliveries": { "default": "mdi:truck-delivery-outline" }
    },
    "device_tracker": {
      "parcel": { "default": "mdi:package-variant-closed", "state": { "out_for_delivery": "mdi:truck-fast", "at_pickup_point": "mdi:store-clock", "returning": "mdi:keyboard-return", "problem": "mdi:package-variant-remove" } }
    },
    "sensor": {
      "receiving": { "default": "mdi:package-variant-closed" },
      "sending": { "default": "mdi:package-up" },
      "delivered": { "default": "mdi:package-variant" },
      "sending_delivered": { "default": "mdi:package-check" },
      "receiving_parcels": { "default": "mdi:package-variant-closed" },
      "delivered_parcels": { "default": "mdi:package-variant" },
      "sending_parcels": { "default": "mdi:package-up" },
      "sending_delivered_parcels": { "default": "mdi:package-check" },
      "en_route_to_pickup_point": { "default": "mdi:truck-delivery" },
      "awaiting_pickup": { "default": "mdi:store-clock" },
      "next_delivery": { "default": "mdi:clock-fast" },
      "last_update": { "default": "mdi:clock-check-outline" },
      "last_backup": { "default": "mdi:database-clock" },
      "open_returns": { "default": "mdi:keyboard-return" },
      "connection_state": { "default": "mdi:account-sync" },
      "job": { "default": "mdi:progress-clock", "state": { "running": "mdi:progress-download", "paused": "mdi:pause-circle-outline", "done": "mdi:check-circle-outline", "failed": "mdi:alert-circle-outline" } },
      "order": { "default": "mdi:shopping", "state": { "partially_delivered": "mdi:shopping-outline" } }
    }
  },
  "services": {
    "track_parcel": { "service": "mdi:package-variant-plus" },
    "archive_parcel": { "service": "mdi:archive-arrow-down" },
    "refresh": { "service": "mdi:refresh" },
    "run_action": { "service": "mdi:play-circle-outline" },
    "cancel_job": { "service": "mdi:stop-circle-outline" }
  }
}